<Window x:Class="DropInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="drop. — Setup"
        Width="820" Height="520" MinWidth="820" MinHeight="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B999FF"/>
    <SolidColorBrush x:Key="Subtle" Color="#9692A3"/>
    <Style x:Key="MainButton" TargetType="Button">
      <Setter Property="Background" Value="#B999FF"/>
      <Setter Property="Foreground" Value="#181020"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="23,14"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBg" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBg" Property="Background" Value="#CFB8FF"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBg" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
      <Setter Property="Background" Value="#24222D"/>
      <Setter Property="Foreground" Value="#E3DDEB"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBg" Background="{TemplateBinding Background}" CornerRadius="11" BorderThickness="1" BorderBrush="#36323E" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBg" Property="Background" Value="#353040"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BareButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A49BAE"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#28242F"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#0E0D13" CornerRadius="20" BorderBrush="#35303D" BorderThickness="1" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.52" Color="#000000"/></Border.Effect>
    <Grid ClipToBounds="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#17141E" CornerRadius="19,0,0,19">
        <Grid Margin="27,34,24,26">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#B999FF" Width="32" Height="32" CornerRadius="11" Margin="0,0,12,0">
              <TextBlock Text="↓" FontFamily="Segoe UI" Foreground="#21162C" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
            </Border>
            <TextBlock FontFamily="Segoe UI" FontSize="26" FontWeight="Bold" Foreground="#F5F1FB" VerticalAlignment="Center">
              <Run Text="drop"/><Run Text="." Foreground="#B999FF"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,95,0,0">
            <TextBlock Text="SETUP" Foreground="#867B91" FontSize="10" FontWeight="Bold" Margin="7,0,0,24"/>
            <StackPanel x:Name="SidebarOne" Orientation="Horizontal" Margin="0,0,0,25">
              <Border x:Name="DotOne" Background="#B999FF" Width="28" Height="28" CornerRadius="9" Margin="0,0,12,0">
                <TextBlock Text="1" Foreground="#1B1323" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Prepare" x:Name="LabelOne" Foreground="#F5F1FB" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="SidebarTwo" Orientation="Horizontal" Margin="0,0,0,25">
              <Border x:Name="DotTwo" Background="#302A39" Width="28" Height="28" CornerRadius="9" Margin="0,0,12,0">
                <TextBlock x:Name="NumTwo" Text="2" Foreground="#9D90AC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Add to Chrome" x:Name="LabelTwo" Foreground="#897F94" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="SidebarThree" Orientation="Horizontal">
              <Border x:Name="DotThree" Background="#302A39" Width="28" Height="28" CornerRadius="9" Margin="0,0,12,0">
                <TextBlock x:Name="NumThree" Text="3" Foreground="#9D90AC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Finish" x:Name="LabelThree" Foreground="#897F94" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Background="#24202B" CornerRadius="8" Padding="10,7" HorizontalAlignment="Left">
              <TextBlock Text="WINDOWS  •  v0.9" FontSize="10" FontWeight="SemiBold" Foreground="#AAA0B6"/>
            </Border>
            <TextBlock Text="A small app. That's all." Foreground="#716779" FontSize="11" Margin="0,13,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
          <TextBlock Text="INSTALLER" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" Foreground="#77707F" FontSize="10" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,21,0">
            <Button Content="−" Click="Minimize_Click" Style="{StaticResource BareButton}" ToolTip="Minimize"/>
            <Button Content="×" Click="Close_Click" Style="{StaticResource BareButton}" ToolTip="Close"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="42,25,48,32">
          <Grid x:Name="PrepareView">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="01  /  PREPARE" Foreground="#B999FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,19"/>
              <TextBlock Text="Install drop." Foreground="#F6F2FA" FontSize="39" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock Text="Everything you need, nothing you don't." Foreground="#AAA2B3" FontSize="14" Margin="0,0,0,28"/>
              <Border Background="#1A1821" BorderBrush="#2F2938" BorderThickness="1" CornerRadius="12" Padding="18,17">
                <StackPanel Orientation="Horizontal">
                  <Border Background="#2B2236" Width="42" Height="42" CornerRadius="11" Margin="0,0,14,0">
                    <TextBlock Text="↓" FontSize="24" FontWeight="Bold" Foreground="#B999FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chrome extension" Foreground="#F2EDF7" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Three files  ·  Installed locally" Foreground="#8E8499" FontSize="11" Margin="0,5,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock x:Name="PrepareError" TextWrapping="Wrap" Foreground="#FFB6BA" FontSize="11" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical">
              <Button x:Name="InstallButton" Content="Install extension files   →" Click="Install_Click" Style="{StaticResource MainButton}" HorizontalAlignment="Left" MinWidth="210"/>
              <TextBlock Text="No administrator access needed." Foreground="#807788" FontSize="11" Margin="0,14,0,0"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="ChromeView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="02  /  ADD TO CHROME" Foreground="#B999FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>
              <TextBlock Text="One last step." Foreground="#F6F2FA" FontSize="37" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock TextWrapping="Wrap" Foreground="#AFA6B8" FontSize="13" LineHeight="22" Margin="0,0,0,24">Chrome needs you to approve the extension once. Here's all you need to do.</TextBlock>
              <TextBlock Foreground="#EDE8F4" FontSize="13" Margin="0,0,0,10"><Run Foreground="#B999FF" Text="1."/><Run Text="  Open Chrome's extensions page."/></TextBlock>
              <TextBlock Foreground="#EDE8F4" FontSize="13" Margin="0,0,0,10"><Run Foreground="#B999FF" Text="2."/><Run Text="  Switch on Developer mode (top right)."/></TextBlock>
              <TextBlock Foreground="#EDE8F4" FontSize="13" Margin="0,0,0,18"><Run Foreground="#B999FF" Text="3."/><Run Text="  Click Load unpacked and select this folder:"/></TextBlock>
              <Border CornerRadius="10" Background="#1C1923" BorderBrush="#383141" BorderThickness="1" Padding="12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="FolderPathText" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11" Foreground="#C4A9E5"/>
                  <Button Grid.Column="1" Content="Copy" Click="CopyPath_Click" Style="{StaticResource SecondaryButton}" Padding="13,8" Margin="10,0,0,0"/>
                </Grid>
              </Border>
              <TextBlock x:Name="ChromeStatus" Foreground="#9DBBA8" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <Button Content="Open Chrome extensions  ↗" Click="OpenChrome_Click" Style="{StaticResource MainButton}" Margin="0,0,12,0"/>
              <Button Content="I'm done  →" Click="Finished_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="DoneView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <Border Background="#2C2237" CornerRadius="12" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,27">
                <TextBlock Text="✓" FontSize="31" FontWeight="SemiBold" Foreground="#B999FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
              </Border>
              <TextBlock Text="You're almost there." Foreground="#F6F2FA" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,13"/>
              <TextBlock Text="If drop. appears on Chrome's extensions page, you're set." Foreground="#AFA6B8" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,24"/>
              <Border Background="#1A1821" BorderBrush="#302A38" BorderThickness="1" CornerRadius="11" Padding="17">
                <TextBlock Foreground="#BDB4C7" TextWrapping="Wrap" FontSize="12" LineHeight="21">Tip: Click the puzzle-piece icon in Chrome's toolbar, then pin drop. to keep it visible.</TextBlock>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
              <Button Content="Open Chrome  ↗" Click="OpenChrome_Click" Style="{StaticResource MainButton}" Margin="0,0,12,0"/>
              <Button Content="Close" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
